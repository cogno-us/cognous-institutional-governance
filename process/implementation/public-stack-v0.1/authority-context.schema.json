                "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "version"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "data_scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "max_amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "max_effects": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "action",
              "targets",
              "data_scopes",
              "max_amount",
              "unit",
              "max_effects"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parent_grant_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "may_delegate": {
              "type": "boolean"
            },
            "remaining_depth": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "parent_grant_id",
            "may_delegate",
            "remaining_depth"
          ]
        },
        "approval_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
          },
          "minItems": 0,
          "uniqueItems": true
        }
