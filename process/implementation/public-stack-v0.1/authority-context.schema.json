{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cognous:alvorada:authority-context:0.1.0",
  "title": "Proposed Authority Context 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "interface_status": {
      "const": "proposed_pending_governor_review"
    },
    "context_id": {
      "type": "string",
      "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "institution_id": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "authority_domain": {
          "type": "string",
          "minLength": 1
        },
        "authority_basis_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
        },
        "authority_mode": {
          "enum": [
            "principle_inspired",
            "modular_adaptation",
            "full_v0.1"
          ]
        }
      },
      "required": [
        "institution_id",
        "authority_domain",
        "authority_basis_ref",
        "authority_mode"
      ]
    },
    "principal": {
      "type": "string",
      "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
    },
    "acting_identity": {
      "type": "string",
      "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
    },
    "accountable_human_role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "human_principal": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "mandate_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
        }
      },
      "required": [
        "role_id",
        "human_principal",
        "mandate_ref"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "governing_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "format": "uri",
                "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provision": {
                "type": "string",
                "minLength": 1
              },
              "standing": {
                "enum": [
                  "design_proposal",
                  "local_policy",
                  "adopted_rule"
