        "issuer": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "issuer_role": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "issuance_record_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
        },
        "grantee": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "acting_identity": {
          "type": "string",
          "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
