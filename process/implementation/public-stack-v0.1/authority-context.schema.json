        "continuity_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
        },
        "remedy_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
        }
      },
