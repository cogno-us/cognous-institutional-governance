            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role_id": {
                "type": "string",
                "pattern": "^urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9:._-]+$"
              },
              "independent_of_actor": {
                "type": "boolean"
              }
