              "source_ref": {
                "type": "string",
                "format": "uri",
                "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
              },
              "max_age_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "required": {
                "type": "boolean"
              },
              "unknown_behavior": {
                "enum": [
                  "hold_effect",
                  "preserve_if_other_basis_suffices",
                  "reconcile_no_blind_retry"
