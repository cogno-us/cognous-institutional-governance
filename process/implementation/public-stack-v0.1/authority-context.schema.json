        "grant_id",
        "revision",
        "requirement_id",
        "issuer",
        "issuer_role",
        "issuance_record_ref",
        "grantee",
        "acting_identity",
        "issued_at",
        "not_before",
        "expires_at",
        "status_ref",
        "policy_versions",
        "permissions",
        "delegation",
        "approval_refs"
