    "supporting_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "policy_proposal",
            "constitutional_proposal"
          ]
        },
        "proposal_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
            },
            {
              "type": "null"
            }
          ]
        },
        "adoption_record_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^(https://[A-Za-z0-9]|urn:[a-z0-9][a-z0-9-]*:[A-Za-z0-9])"
